rules_version = '2';

// Devora — Firestore security rules.
// Paste this whole file into Firebase console -> Firestore Database -> Rules
// -> Publish. The site's data is protected by these rules, not by keeping
// the web config secret.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // An admin has a document at admins/{their uid}. Add those documents by
    // hand in the Firebase console; the site can never create them.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function optionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null
        || (data[key] is string && data[key].size() <= maxLen);
    }

    // a link field: empty, a web address, or a path into the site's assets
    // folder — never javascript:, data: or anything else a browser might run
    function safeLink(data, key) {
      return !(key in data) || data[key] == null || data[key] == ''
        || (data[key] is string && data[key].size() <= 500
            && data[key].matches('^(https?://|/?assets/)[^\\s"<>]*$'));
    }

    function validProject(d) {
      return d.keys().hasOnly(['title', 'category', 'description', 'tags',
                               'image_url', 'live_url', 'case_study_url', 'created_at'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.category in ['websites', 'mobile', 'uiux']
        && optionalString(d, 'description', 400)
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 12))
        && safeLink(d, 'image_url') && safeLink(d, 'live_url') && safeLink(d, 'case_study_url');
    }

    // ---- admins: each signed-in user may only check their own entry ----
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- orders: anyone can submit one; only admins can see or manage ----
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'email', 'company', 'phone', 'project_type', 'budget',
           'timeline', 'details', 'status', 'source', 'created_at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0 && request.resource.data.email.size() < 200
        && optionalString(request.resource.data, 'company', 200)
        && optionalString(request.resource.data, 'phone', 60)
        && optionalString(request.resource.data, 'project_type', 100)
        && optionalString(request.resource.data, 'budget', 100)
        && optionalString(request.resource.data, 'timeline', 200)
        && optionalString(request.resource.data, 'details', 5000)
        && optionalString(request.resource.data, 'source', 60)
        && request.resource.data.status == 'new'
        && request.resource.data.created_at == request.time;
      allow read, delete: if isAdmin();
      // admins may only change an order's status and their private notes,
      // never what the customer submitted
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'admin_notes'])
        && request.resource.data.status in ['new', 'contacted', 'in_progress', 'completed', 'archived']
        && optionalString(request.resource.data, 'admin_notes', 5000);
    }

    // ---- projects: public portfolio; only admins can change it ----
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && validProject(request.resource.data)
        && request.resource.data.created_at == request.time;
      // edits can't change when the project was created
      allow update: if isAdmin() && validProject(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isAdmin();
    }

    // ---- analytics_events: anonymous visit tracking (js/track.js) ----
    match /analytics_events/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['type', 'path', 'label', 'referrer', 'session_id', 'device', 'created_at',
           'utm_source', 'utm_medium', 'utm_campaign'])
        && request.resource.data.type in ['pageview', 'click', 'form_start', 'form_submit']
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0 && request.resource.data.path.size() <= 200
        && optionalString(request.resource.data, 'label', 120)
        && optionalString(request.resource.data, 'referrer', 120)
        && optionalString(request.resource.data, 'utm_source', 60)
        && optionalString(request.resource.data, 'utm_medium', 60)
        && optionalString(request.resource.data, 'utm_campaign', 60)
        && request.resource.data.session_id is string
        && request.resource.data.session_id.size() >= 8 && request.resource.data.session_id.size() <= 64
        && request.resource.data.device in ['mobile', 'tablet', 'desktop']
        // the browser stamps the time, so only accept times close to now
        && request.resource.data.created_at is timestamp
        && request.resource.data.created_at > request.time - duration.value(5, 'm')
        && request.resource.data.created_at < request.time + duration.value(5, 'm');
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
